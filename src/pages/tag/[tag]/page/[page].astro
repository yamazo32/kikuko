---
import { getCollection, render } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import PostItem from "../../../../components/PostItem.astro";
import Pagination from "../../../../components/Pagination.astro";

const getTimestamp = (dateVal: any) => {
  if (!dateVal) return 0;
  const normalized =
    typeof dateVal === "string" ? dateVal.replace(/-/g, "/") : dateVal;
  const time = new Date(normalized).valueOf();
  return Number.isNaN(time) ? 0 : time;
};

export async function getStaticPaths({ paginate }) {
  // status: "publish" の公開記事のみに絞り込む
  const posts = (await getCollection("blog")).filter(
    (p) => p.data.status === "publish",
  );
  const tagMap = new Map<string, { name: string; posts: any[] }>();

  posts.forEach((p) => {
    const rawTags = p.data.tags || [];
    rawTags.forEach((tag: any) => {
      const rawSlug = typeof tag === "string" ? tag : tag.slug || tag.name;
      const tName = typeof tag === "string" ? tag : tag.name || tag.slug;

      if (rawSlug) {
        let decodedSlug = rawSlug;
        try {
          decodedSlug = decodeURIComponent(rawSlug);
        } catch {
          decodedSlug = rawSlug;
        }

        if (!tagMap.has(decodedSlug)) {
          tagMap.set(decodedSlug, { name: tName || decodedSlug, posts: [] });
        }
        tagMap.get(decodedSlug)!.posts.push(p);
      }
    });
  });

  const paths: any[] = [];

  tagMap.forEach(({ name, posts: tagPosts }, decodedSlug) => {
    const sortedPosts = tagPosts.sort(
      (a, b) =>
        new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    );

    paths.push(
      ...paginate(sortedPosts, {
        pageSize: 10,
        params: { tag: decodedSlug },
        props: { tagName: name, canonicalTag: decodedSlug },
      }),
    );

    const encodedSlug = encodeURIComponent(decodedSlug);
    if (encodedSlug !== decodedSlug) {
      paths.push(
        ...paginate(sortedPosts, {
          pageSize: 10,
          params: { tag: encodedSlug },
          props: { tagName: name, canonicalTag: decodedSlug },
        }),
      );
    }
  });

  return paths;
}

const { page, tagName, canonicalTag } = Astro.props;
const posts = page.data;

const postsWithContent = await Promise.all(
  posts.map(async (p: any) => {
    const { Content } = await render(p);
    return { post: p, Content };
  }),
);
---

<Layout
  title={`Tag: ${tagName} (Page ${page.currentPage}) | 喜久子教室 草月/京都きもの専門学院`}
>
  <p class="page-title">
    Tag Archives: <span>{tagName}</span>
  </p>

  {postsWithContent.map(({ post, Content }) => (
    <PostItem post={post} Content={Content} />
  ))}

  <Pagination page={page} baseUrl={`/tag/${canonicalTag}/`} />
</Layout>
