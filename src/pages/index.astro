---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostItem from "../components/PostItem.astro";
import Pagination from "../components/Pagination.astro";

const getTimestamp = (dateVal: any) => {
  if (!dateVal) return 0;
  const normalized =
    typeof dateVal === "string" ? dateVal.replace(/-/g, "/") : dateVal;
  const time = new Date(normalized).valueOf();
  return Number.isNaN(time) ? 0 : time;
};

// 公開記事のみに絞り込み、安全に日付ソート
const posts = (await getCollection("blog"))
  .filter((p) => p.data.status === "publish")
  .sort((a, b) => getTimestamp(b.data.date) - getTimestamp(a.data.date));

const pageSize = 10;
const currentPosts = posts.slice(0, pageSize);

const postsWithContent = await Promise.all(
  currentPosts.map(async (p) => {
    const { Content } = await render(p);
    return { post: p, Content };
  }),
);

const page = {
  currentPage: 1,
  lastPage: Math.ceil(posts.length / pageSize),
  url: {
    prev: null,
    next: posts.length > pageSize ? "/page/2/" : null,
  },
};
---

<Layout title="喜久子教室 草月/京都きもの専門学院">
  {postsWithContent.map(({ post, Content }) => (
    <PostItem post={post} Content={Content} />
  ))}

  <Pagination page={page} baseUrl="/" />
</Layout>
