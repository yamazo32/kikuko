<!-- タグクラウド -->
<aside class="widget widget_tag_cloud">
  <h1>タグ</h1>
  <div class="tagcloud">
    {sortedTags.map(([tagSlug, { name: tagName, count }], index) => {
      let fontSize = 8;
      // カウントが最大値を超えても22ptで頭打ちにする
      const effectiveCount = Math.min(count, maxTagCount);

      if (maxTagCount > minTagCount) {
        const ratio =
          (effectiveCount - minTagCount) / (maxTagCount - minTagCount);
        const curvedRatio = Math.pow(ratio, 0.6);
        fontSize = 8 + curvedRatio * (22 - 8);
      } else {
        fontSize = 15;
      }

      return (
        <a
          href={`${base}tag/${tagSlug}/`}
          class={`tag-cloud-link tag-link-position-${index + 1}`}
          style={`font-size: ${fontSize.toFixed(2)}pt;`}
          aria-label={`${tagName} (${count}個の項目)`}
        >
          {tagName}
        </a>
      );
    })}
  </div>
</aside>
<!-- /.widget_tag_cloud -->

<!-- カテゴリー -->
<aside class="widget widget_categories">
  <h1>カテゴリー</h1>
  <ul>
    <li class="cat-item">
      <a href={`${base}sogetsu/`}>
        草月 <span class="count">{sogetsuTotalCount}</span>
      </a>
      {sortedSogetsuSubCategories.length > 0 && (
        <ul class="children">
          {sortedSogetsuSubCategories.map(([slug, { name, count }]) => (
            <li class="cat-item">
              <a href={`${base}sogetsu/${slug}/`}>
                {name} <span class="count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </li>
    <li class="cat-item">
      <a href={`${base}tenjikai/`}>
        展覧会 <span class="count">{tenjikaiTotalCount}</span>
      </a>
    </li>
  </ul>
</aside>
<!-- /.widget_categories -->

